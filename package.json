{
  "name": "gw2-decoration-editor",
  "version": "0.1.0",
  "description": "Guild Wars 2 Decoration Editor",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "npm run build && npm run preview",
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "build:prod": "tsc --noEmit && vite build --base=/gw2-deco/",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.strict.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
